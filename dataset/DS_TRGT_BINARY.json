{
	"name": "DS_TRGT_BINARY",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_GEN2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"TRGT_FileName": {
				"type": "string"
			},
			"TRGT_FOLDER": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().TRGT_FileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('Processeddd/',dataset().TRGT_FOLDER)",
					"type": "Expression"
				},
				"fileSystem": "hk-quant-container"
			}
		}
	}
}