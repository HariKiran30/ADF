															"SRC_FILE_NAME": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_TRGT_ADLS_BINARY_CSV",
														"type": "DatasetReference",
														"parameters": {
															"TRGT_FILE_NAME": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												]
											}
