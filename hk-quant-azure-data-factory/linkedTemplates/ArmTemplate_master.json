{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "hk-quant-azure-data-factory"
		},
		"LS_ADLS_GEN2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_GEN2'"
		},
		"LS_AZURE_SQL_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZURE_SQL_DB'"
		},
		"LS_ONPREM_SQL_SEREVR_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ONPREM_SQL_SEREVR'"
		},
		"LS_ADLS_GEN2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hkquantstorageaccount.dfs.core.windows.net/"
		},
		"LS_AZURE_SQL_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "hk-server.database.windows.net"
		},
		"LS_AZURE_SQL_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "hkDB"
		},
		"LS_AZURE_SQL_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "HK"
		},
		"LS_ONPREM_SQL_SEREVR_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-VD69ORK"
		},
		"LS_ONPREM_SQL_SEREVR_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksL"
		},
		"LS_ONPREM_SQL_SEREVR_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "userAdf1"
		},
		"EventBasedTriggerADLS_properties_PL_EVENT_TRIGGERS_parameters_src_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"EventBasedTriggerADLS_properties_PL_EVENT_TRIGGERS_parameters_src_folder_name": {
			"type": "string",
			"defaultValue": "@triggerBody().folderPath"
		},
		"EventBasedTriggerADLS_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/d1ebf0bc-a6d8-44f7-ba99-6f6e86c47ac5/resourceGroups/rg-quantcloud-technologies/providers/Microsoft.Storage/storageAccounts/hkquantstorageaccount"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "hk-quant-azure-data-factory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_GEN2_accountKey": {
						"value": "[parameters('LS_ADLS_GEN2_accountKey')]"
					},
					"LS_AZURE_SQL_DB_password": {
						"value": "[parameters('LS_AZURE_SQL_DB_password')]"
					},
					"LS_ADLS_GEN2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_GEN2_properties_typeProperties_url')]"
					},
					"LS_AZURE_SQL_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_AZURE_SQL_DB_properties_typeProperties_server')]"
					},
					"LS_AZURE_SQL_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_AZURE_SQL_DB_properties_typeProperties_database')]"
					},
					"LS_AZURE_SQL_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_AZURE_SQL_DB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "hk-quant-azure-data-factory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ONPREM_SQL_SEREVR_password": {
						"value": "[parameters('LS_ONPREM_SQL_SEREVR_password')]"
					},
					"LS_ONPREM_SQL_SEREVR_properties_typeProperties_server": {
						"value": "[parameters('LS_ONPREM_SQL_SEREVR_properties_typeProperties_server')]"
					},
					"LS_ONPREM_SQL_SEREVR_properties_typeProperties_database": {
						"value": "[parameters('LS_ONPREM_SQL_SEREVR_properties_typeProperties_database')]"
					},
					"LS_ONPREM_SQL_SEREVR_properties_typeProperties_userName": {
						"value": "[parameters('LS_ONPREM_SQL_SEREVR_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'hk-quant-azure-data-factory_ArmTemplate_0')]"
			]
		},
		{
			"name": "hk-quant-azure-data-factory_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"EventBasedTriggerADLS_properties_PL_EVENT_TRIGGERS_parameters_src_file_name": {
						"value": "[parameters('EventBasedTriggerADLS_properties_PL_EVENT_TRIGGERS_parameters_src_file_name')]"
					},
					"EventBasedTriggerADLS_properties_PL_EVENT_TRIGGERS_parameters_src_folder_name": {
						"value": "[parameters('EventBasedTriggerADLS_properties_PL_EVENT_TRIGGERS_parameters_src_folder_name')]"
					},
					"EventBasedTriggerADLS_properties_typeProperties_scope": {
						"value": "[parameters('EventBasedTriggerADLS_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'hk-quant-azure-data-factory_ArmTemplate_1')]"
			]
		}
	]
}