{
	"name": "PL_CSV_TO_PARQUET_DYNAMIC",
	"properties": {
		"activities": [
			{
				"name": "CopyCsvToParquet",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_SRC_CSV_DYNAMIC",
						"type": "DatasetReference",
						"parameters": {
							"SRC_FILENAME": {
								"value": "@pipeline().parameters.P_FILE_NAME",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_TRGT_PRC_PARQUET",
						"type": "DatasetReference",
						"parameters": {
							"TRGT_FOLDER": {
								"value": "@concat( 'processed_Parq01/', formatDateTime(utcNow(),'yyyy/MM/dd/') )",
								"type": "Expression"
							},
							"TRGT_FILE_NAME": {
								"value": "@concat(\nreplace(pipeline().parameters.P_FILE_NAME,'.csv',''),\n'_',\nformatDateTime(utcNow(),'yyyyMMdd'),\n'.parquet'\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "DELETE_SOURCE_FILE",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "CopyCsvToParquet",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_SRC_CSV_DYNAMIC",
						"type": "DatasetReference",
						"parameters": {
							"SRC_FILENAME": "@pipeline().parameters.P_FILE_NAME"
						}
					},
					"logStorageSettings": {
						"linkedServiceName": {
							"referenceName": "LS_ADLS_GEN2",
							"type": "LinkedServiceReference"
						}
					},
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"parameters": {
			"P_FOLDER_PATH": {
				"type": "string"
			},
			"P_FILE_NAME": {
				"type": "string"
			}
		},
		"annotations": []
	}
}