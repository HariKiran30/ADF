{
	"name": "EventBasedTriggerADLS",
	"properties": {
		"annotations": [],
		"runtimeState": "Started",
		"pipelines": [
			{
				"pipelineReference": {
					"referenceName": "PL_EVENT_TRIGGERS",
					"type": "PipelineReference"
				},
				"parameters": {
					"src_file_name": "@triggerBody().fileName",
					"src_folder_name": "@triggerBody().folderPath"
				}
			},
			{
				"pipelineReference": {
					"referenceName": "PL_CSV_TO_PARQUET_DYNAMIC",
					"type": "PipelineReference"
				},
				"parameters": {
					"P_FOLDER_PATH": "@triggerBody().folderPath",
					"P_FILE_NAME": "@triggerBody().fileName"
				}
			}
		],
		"type": "BlobEventsTrigger",
		"typeProperties": {
			"blobPathBeginsWith": "/hk-quant-container/blobs/DIR_CSV_files",
			"blobPathEndsWith": ".csv",
			"ignoreEmptyBlobs": true,
			"scope": "/subscriptions/d1ebf0bc-a6d8-44f7-ba99-6f6e86c47ac5/resourceGroups/rg-quantcloud-technologies/providers/Microsoft.Storage/storageAccounts/hkquantstorageaccount",
			"events": [
				"Microsoft.Storage.BlobCreated"
			]
		}
	}
}